static func key(id: int) -> String:
	return KEYS[id] if id >= 0 and id < KEYS.size() else ""


static func name(id: int) -> String:
	return NAMES[id] if id >= 0 and id < NAMES.size() else ""


static func verb(id: int) -> String:
	return VERBS[id] if id >= 0 and id < VERBS.size() else ""


static func shout(id: int) -> String:
	return SHOUTS[id] if id >= 0 and id < SHOUTS.size() else ""


static func clip(id: int) -> String:
	return CLIPS[id] if id >= 0 and id < CLIPS.size() else ""


static func shot(id: int) -> String:
	return SHOTS[id] if id >= 0 and id < SHOTS.size() else ""


static func length(id: int) -> float:
	return LENGTHS[id] if id >= 0 and id < LENGTHS.size() else 0.0


## Four nickname words, or none for an id that isn't a weapon.
static func words(id: int) -> Array:
	return WORDS[id] if id >= 0 and id < WORDS.size() else []
