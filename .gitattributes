# Normalise text files; keep Godot's text formats as LF so diffs are clean on every OS.
* text=auto
*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.sln     text eol=crlf
*.md      text
*.json    text
*.godot   text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.import  text eol=lf
*.gd      text eol=lf
*.gdshader text eol=lf
*.cfg     text eol=lf
*.svg     text
*.gltf    text

# --- Git LFS: binary assets ---
# Images / textures / paintings
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
