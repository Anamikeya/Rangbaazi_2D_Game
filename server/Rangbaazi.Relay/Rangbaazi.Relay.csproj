<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Online server for the web and Android builds (browsers cannot use UDP). Two kinds of room:
    /relay/room pairs two players and forwards their rollback messages verbatim (no game logic);
    /relay/arena hosts rooms of up to 15 players and runs their match itself with the
    deterministic sim (src/Rangbaazi.Sim), sending every player the state each frame.
    Protocol and deployment notes: README.md in this folder.
    Uses the workstation GC rather than the server GC, to stay small on a little instance.
  -->
  <PropertyGroup>
    <TargetFramework>$(RangbaaziTargetFramework)</TargetFramework>
    <RootNamespace>Rangbaazi.Relay</RootNamespace>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rangbaazi.Relay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rangbaazi.Sim\Rangbaazi.Sim.csproj" />
  </ItemGroup>
</Project>
